---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title="About — Yamato" description="M.Sc. Cybersecurity student building verifiable-AI research, agent-memory tooling and local-first software.">
  <section class="container wrap">
    <p class="label">about</p>
    <h1>Yamato</h1>

    <p class="lede muted">
      M.Sc. Cybersecurity at Tarbiat Modares University (Tehran) and B.Sc.
      Computer Engineering at Islamic Azad University Mashhad. Based in Iran,
      building under No One's Studio.
    </p>

    <h2>Interests</h2>
    <p class="muted">Verifiable AI, agent memory, applied ML, security.</p>

    <h2>Currently</h2>
    <ul class="now">
      <li>nomem — open-core knowledge-graph memory library for LLM apps.</li>
      <li>Research on verifiable inference for GraphRAG in regulatory domains.</li>
      <li>Local-first tools under No One's Studio.</li>
    </ul>

    <h2>Stack</h2>
    <p class="muted">Python · TypeScript · PostgreSQL · Neo4j · Docker · Linux</p>

    <h2>Elsewhere</h2>
    <ul class="links">
      <li><a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a></li>
      <li><a href={SITE.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></li>
      <li><a href={SITE.devto} target="_blank" rel="noreferrer">dev.to/yamato0234 ↗</a></li>
      <li><a href={SITE.studioUrl} target="_blank" rel="noreferrer">no0nestudio.com ↗</a></li>
    </ul>
  </section>
</Base>

<style>
  .wrap { padding: 4rem 1.25rem 3rem; max-width: 720px; }
  .lede { font-size: var(--step-1); margin-bottom: 2rem; }
  h2 { margin-top: 2.5rem; font-size: var(--step-2); }
  .now { padding-left: 1.25rem; }
  .now li { margin: 0.4rem 0; color: var(--text-muted); }
  .now em { color: var(--text); font-style: normal; }
  .links { list-style: none; padding: 0; }
  .links li { margin: 0.4rem 0; }
</style>
